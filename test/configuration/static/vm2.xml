<domain type="kvm">
    <name>vm2</name>
    <uuid>36d01e0c-cdf7-d2eb-35ea-55c6d0d47155</uuid>
    <vcpu placement="static">1</vcpu>
    <memory unit="MiB">4096</memory>
    <os>
        <type arch="x86_64">hvm</type>
        <boot dev="hd"/>
    </os>
    <devices>
        <emulator>/usr/bin/qemu-system-x86_64</emulator>
        <disk device="disk" type="file">
            <driver name="qemu" type="qcow2"/>
            <source file="/home/kaio/.freyja/machines/vm2/overlay-image.qcow2"/>
            <backingStore type="file">
                <format type="qcow2"/>
                <source file="/tmp/debian-12-generic-amd64.qcow2"/>
            </backingStore>
            <target bus="ide" dev="hda"/>
        </disk>
        <disk device="cdrom" type="file">
            <driver name="qemu" type="raw"/>
            <source file="/home/kaio/.freyja/machines/vm2/cloud-init.iso"/>
            <target bus="ide" dev="hdb"/>
        </disk>
        <interface type="network">
            <source network="default"/>
            <address type="pci" domain="0x0000" bus="0x00" slot="0x02" function="0x0"/>
        </interface>
        <console type="pty">
            <target type="serial"/>
        </console>
    </devices>
</domain>
